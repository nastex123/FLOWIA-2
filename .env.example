# ==============================================================================
# FlowMind AI - Environment Variables Template
# ==============================================================================

# Application Configuration
APP_NAME=FlowMind AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-insecure-secret-key-for-production-min-32-chars
ALLOWED_ORIGINS=["http://localhost:3000"]

# PostgreSQL Database (Asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flowmind
DATABASE_ECHO=false

# Redis Cache & Background Tasks
REDIS_URL=redis://localhost:6379/0

# Storage Configuration (local | s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage

# MinIO / S3 Compatible Storage (when STORAGE_BACKEND=s3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=flowmind-documents
S3_USE_SSL=false

# Security & Document Processing Limits
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["xlsx","xls","csv","pdf"]
