# ==============================================================================
# FlowMind AI - Environment Variables Template
# ==============================================================================

# Application Configuration
APP_NAME=FlowMind AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-insecure-secret-key-for-production-min-32-chars
ALLOWED_ORIGINS=["*"]

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Opción A: SQLite Asíncrono Local (Por defecto, funciona out-of-the-box en Windows y Linux)
DATABASE_URL=sqlite+aiosqlite:///./data/flowmind.db
DATABASE_ECHO=false

# Opción B: PostgreSQL Asíncrono (Usar cuando se levante Docker Compose)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flowmind

# ------------------------------------------------------------------------------
# 2. REDIS / BACKGROUND TASKS (Opcional en modo local)
# ------------------------------------------------------------------------------
# En modo local sin Docker, dejar comentado (el sistema usa cola en memoria interna).
# En modo Docker / Producción:
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. STORAGE CONFIGURATION (local | s3)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local

# Rutas de almacenamiento local:
# - En Windows y Linux se admiten rutas relativas estándar: ./data/storage
# - Si se especifica ruta absoluta en Windows: C:/Users/Usuario/data/storage
# - Si se especifica ruta absoluta en Linux: /var/flowmind/data/storage
LOCAL_STORAGE_PATH=./data/storage

# MinIO / S3 Compatible Storage (solo cuando STORAGE_BACKEND=s3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=flowmind-documents
S3_USE_SSL=false

# ------------------------------------------------------------------------------
# 4. SECURITY & DOCUMENT PROCESSING LIMITS
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["xlsx","xls","csv","pdf","png","jpg","jpeg","tiff","bmp","webp"]

